<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Network access for downloading -->
  <key>com.apple.security.network.client</key>
  <true/>
  
  <!-- Outgoing network connections -->
  <key>com.apple.security.network.server</key>
  <false/>
  
  <!-- File system access -->
  <key>com.apple.security.files.user-selected.read-write</key>
  <true/>
  
  <!-- Downloads folder access -->
  <key>com.apple.security.files.downloads.read-write</key>
  <true/>
  
  <!-- Disable code injection protection -->
  <key>com.apple.security.cs.allow-jit</key>
  <false/>
  
  <!-- Disable unsigned executable memory -->
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <false/>
  
  <!-- Disable dynamic library loading -->
  <key>com.apple.security.cs.allow-dyld-environment-variables</key>
  <false/>
  
  <!-- Disable library validation for Electron -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
  
  <!-- Allow launching child processes (needed for yt-dlp execution) -->
  <key>com.apple.security.inherit</key>
  <true/>
  
  <!-- File system access for all locations -->
  <key>com.apple.security.files.all</key>
  <true/>
  
  <!-- Hardened runtime -->
  <key>com.apple.security.automation.apple-events</key>
  <false/>
  
  <!-- Allow debugger attachment (for development) -->
  <key>com.apple.security.cs.debugger</key>
  <true/>
</dict>
</plist>