# Copy to .env and fill in what you need. Every value is optional; leaving one
# empty keeps the feature that uses it disabled.

# Error reporting (TelemetryService)
VITE_TELEMETRY_ENDPOINT=
VITE_TELEMETRY_TIMEOUT=30000
VITE_TELEMETRY_RETRY_ATTEMPTS=3
VITE_TELEMETRY_SCHEMA_URL=https://opentelemetry.io/schemas/1.9.0

# OpenTelemetry log collector (otel-logs.js)
VITE_OTEL_LOGS_ENDPOINT=

# Share links (shareHandler.ts)
VITE_SHARE_API_ENDPOINT=
VITE_SHARE_API_KEY=

# Video summarization service (useSummarizeVideo.ts)
VITE_SUMMARY_API_ENDPOINT=
